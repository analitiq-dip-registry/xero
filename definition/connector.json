{
  "$schema": "https://schemas.analitiq.ai/connector/latest.json",
  "kind": "api",
  "connector_id": "xero",
  "display_name": "Xero",
  "description": "Xero cloud accounting platform. Reads and writes accounting data — invoices, credit notes, contacts, bank transactions, payments, items, accounts, manual journals, the general ledger and organisation settings — via the Xero Accounting API (api.xro/2.0). OAuth 2.0 authorization code with granular accounting scopes and refresh-token rotation; each connection targets exactly one Xero organisation (tenant), selected after authorisation from GET /connections.",
  "documentation_url": "https://developer.xero.com/documentation/api/accounting/overview",
  "tags": [
    "api",
    "accounting",
    "xero",
    "oauth2",
    "finance"
  ],
  "version": "0.1.0",
  "default_transport": "api",
  "transport_defaults": {
    "transport_type": "http",
    "headers": {
      "Accept": "application/json",
      "Authorization": {
        "template": "Bearer ${auth.access_token}"
      }
    },
    "timeout_seconds": 30
  },
  "transports": {
    "api": {
      "transport_type": "http",
      "base_url": "https://api.xero.com/api.xro/2.0/",
      "headers": {
        "Xero-tenant-id": {
          "ref": "connection.selections.tenantId"
        }
      },
      "rate_limit": {
        "max_requests": 60,
        "time_window_seconds": 60
      }
    },
    "identity": {
      "transport_type": "http",
      "base_url": "https://api.xero.com"
    },
    "auth": {
      "transport_type": "http",
      "base_url": "https://identity.xero.com",
      "headers": {
        "Authorization": {
          "function": "basic_auth",
          "input": {
            "username": {
              "ref": "connection.parameters.client_id"
            },
            "password": {
              "ref": "secrets.client_secret"
            }
          }
        }
      }
    },
    "login": {
      "transport_type": "http",
      "base_url": "https://login.xero.com",
      "headers_remove": [
        "Authorization"
      ]
    }
  },
  "auth": {
    "type": "oauth2_authorization_code",
    "authorize": {
      "transport_ref": "login",
      "method": "GET",
      "path": "/identity/connect/authorize",
      "body": {
        "template": "response_type=code&client_id=${connection.parameters.client_id}&redirect_uri=${runtime.oauth.redirect_uri}&scope=openid profile email offline_access accounting.settings accounting.contacts accounting.invoices accounting.banktransactions accounting.payments accounting.manualjournals accounting.journals.read&state=${runtime.oauth.state}"
      }
    },
    "token_exchange": {
      "transport_ref": "auth",
      "method": "POST",
      "path": "/connect/token",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      },
      "body": {
        "template": "grant_type=authorization_code&code=${runtime.oauth.code}&redirect_uri=${runtime.oauth.redirect_uri}"
      }
    },
    "refresh": {
      "transport_ref": "auth",
      "method": "POST",
      "path": "/connect/token",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      },
      "body": {
        "template": "grant_type=refresh_token&refresh_token=${auth.refresh_token}"
      }
    },
    "test": {
      "transport_ref": "identity",
      "method": "GET",
      "path": "/connections"
    }
  },
  "connection_contract": {
    "inputs": {
      "client_id": {
        "source": "platform",
        "phase": "auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true
      },
      "client_secret": {
        "source": "platform",
        "phase": "auth",
        "storage": "secrets",
        "type": "string",
        "required": true,
        "secret": true
      }
    },
    "post_auth_outputs": {
      "tenantId": {
        "mode": "user_selection",
        "storage": "connection.selections",
        "type": "string",
        "value_path": "tenantId",
        "label_path": "tenantName",
        "options_request": {
          "transport_ref": "identity",
          "method": "GET",
          "path": "/connections"
        },
        "ui": {
          "label": "Xero organisation",
          "help_text": "Choose the Xero organisation this connection syncs. One connection targets exactly one organisation — connect again to sync another.",
          "widget": "select"
        }
      }
    },
    "required_for_activation": [
      "connection.selections.tenantId"
    ]
  },
  "error_map": {
    "http": {
      "401": "auth",
      "429": "rate_limited"
    }
  },
  "concurrency": {
    "max_connections": 5
  }
}
