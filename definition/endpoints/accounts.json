{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "accounts",
  "display_name": "Accounts",
  "description": "The full chart of accounts for the organisation.",
  "tags": ["accounting", "settings"],
  "operations": {
    "read": {
      "request": {
        "method": "GET",
        "path": "Accounts"
      },
      "params": {
        "If-Modified-Since": {
          "in": "header",
          "type": "string",
          "required": false,
          "controlled_by": "replication",
          "description": "RFC3339 timestamp; only records created/modified at or after are returned."
        }
      },
      "replication": {
        "supported_methods": ["full_refresh", "incremental"],
        "cursor_mappings": [
          {
            "cursor_field": "UpdatedDateUTC",
            "param": "If-Modified-Since",
            "operator": "gte",
            "format": "date-time"
          }
        ]
      },
      "response": {
        "records": { "ref": "response.body.Accounts" },
        "schema": {
          "type": "object",
          "properties": {
            "Id":           { "type": "string", "native_type": "UUID",     "arrow_type": "Utf8" },
            "Status":       { "type": "string", "native_type": "String",   "arrow_type": "Utf8" },
            "ProviderName": { "type": "string", "native_type": "String",   "arrow_type": "Utf8" },
            "DateTimeUTC":  { "type": "string", "native_type": "DateTime", "arrow_type": "Utf8" },
            "Accounts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "Code":                    { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "Name":                    { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "AccountID":               { "type": "string",  "native_type": "UUID",     "arrow_type": "Utf8" },
                  "Type":                    { "type": "object",  "native_type": "Json",     "arrow_type": "Json" },
                  "BankAccountNumber":       { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "Status":                  { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "Description":             { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "BankAccountType":         { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "CurrencyCode":            { "type": "object",  "native_type": "Json",     "arrow_type": "Json" },
                  "TaxType":                 { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "EnablePaymentsToAccount": { "type": "boolean", "native_type": "Boolean",  "arrow_type": "Boolean" },
                  "ShowInExpenseClaims":     { "type": "boolean", "native_type": "Boolean",  "arrow_type": "Boolean" },
                  "Class":                   { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "SystemAccount":           { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "ReportingCode":           { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "ReportingCodeName":       { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "HasAttachments":          { "type": "boolean", "native_type": "Boolean",  "arrow_type": "Boolean" },
                  "UpdatedDateUTC":          { "type": "string",  "native_type": "DateTime", "arrow_type": "Utf8" },
                  "AddToWatchlist":          { "type": "boolean", "native_type": "Boolean",  "arrow_type": "Boolean" },
                  "ValidationErrors":        { "type": "array",   "native_type": "Json",     "arrow_type": "Json" }
                }
              }
            }
          }
        }
      }
    }
  }
}
