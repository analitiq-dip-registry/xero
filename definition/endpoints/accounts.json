{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "accounts",
  "display_name": "Accounts",
  "description": "Chart of accounts for the connected Xero organisation. Read is a single unpaginated GET Accounts (Xero documents no pagination on this resource; getAccounts also exposes where and order, both omitted here as non-populatable — a Xero where expression is an opaque predicate DSL, not a filterable field, and order is a sort directive); incremental sync is driven by the If-Modified-Since REQUEST HEADER on the UpdatedDateUTC cursor. Write covers CREATE ONLY. Xero exposes PUT Accounts (create, taking a single Account object — not an array) and POST Accounts/{AccountID} (update, id in the path); there is NO collection-level POST Accounts, so this resource has no single-request upsert like the other writable Xero resources. The update operation is deliberately not authored: its AccountID must travel in the request path, request.path_params accepts only {from_param} bindings, and from_input (the record being written) is legal only in a write request body — so no endpoint document can route a per-record AccountID into the path. Only the insert mode is expressible here; updating an existing account is out of scope for this connector version.",
  "tags": [
    "accounting",
    "settings"
  ],
  "operations": {
    "read": {
      "request": {
        "method": "GET",
        "path": "Accounts",
        "headers": {
          "If-Modified-Since": {
            "from_param": "If-Modified-Since"
          }
        }
      },
      "params": {
        "If-Modified-Since": {
          "in": "header",
          "type": "string",
          "required": false,
          "format": "date-time",
          "controlled_by": "replication",
          "description": "Only records created or modified at/after this timestamp are returned. Xero documents the value as an ISO-8601 timestamp, e.g. 2020-02-06T12:17:43.202-08:00."
        }
      },
      "replication": {
        "supported_methods": [
          "full_refresh",
          "incremental"
        ],
        "cursor_mappings": [
          {
            "cursor_field": "UpdatedDateUTC",
            "param": "If-Modified-Since",
            "operator": "gte",
            "format": "date-time"
          }
        ]
      },
      "response": {
        "records": {
          "ref": "response.body.Accounts"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "Xero GET Accounts response",
          "description": "Xero wraps records in the standard response envelope alongside Id/Status/ProviderName/DateTimeUTC metadata; the Accounts array carries the records.",
          "type": "object",
          "properties": {
            "Id": {
              "type": "string",
              "description": "Envelope: request correlation id assigned by Xero."
            },
            "Status": {
              "type": "string",
              "description": "Envelope: request status, 'OK' on success. Not the per-account Status field."
            },
            "ProviderName": {
              "type": "string",
              "description": "Envelope: the name of the calling Xero app."
            },
            "DateTimeUTC": {
              "type": "string",
              "description": "Envelope: response timestamp in Xero MS-JSON form, e.g. /Date(1550797359081)/."
            },
            "Accounts": {
              "type": "array",
              "description": "The record collection.",
              "items": {
                "type": "object",
                "title": "Account",
                "properties": {
                  "AccountID": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": false,
                    "native_type": "string:uuid",
                    "arrow_type": "Utf8",
                    "description": "Xero identifier for the account, e.g. ebd06280-af70-4bed-97c6-7451a454ad85."
                  },
                  "Code": {
                    "type": "string",
                    "nullable": true,
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Customer-defined account code, e.g. 091."
                  },
                  "Name": {
                    "type": "string",
                    "nullable": true,
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Name of the account, e.g. Business Savings Account."
                  },
                  "Status": {
                    "type": "string",
                    "nullable": true,
                    "native_type": "string:enum",
                    "arrow_type": "Utf8",
                    "enum": [
                      "ACTIVE",
                      "ARCHIVED",
                      "DELETED"
                    ],
                    "description": "Account status."
                  },
                  "Type": {
                    "type": "string",
                    "nullable": true,
                    "native_type": "string:enum",
                    "arrow_type": "Utf8",
                    "enum": [
                      "BANK",
                      "CURRENT",
                      "CURRLIAB",
                      "DEPRECIATN",
                      "DIRECTCOSTS",
                      "EQUITY",
                      "EXPENSE",
                      "FIXED",
                      "INVENTORY",
                      "LIABILITY",
                      "NONCURRENT",
                      "OTHERINCOME",
                      "OVERHEADS",
                      "PREPAYMENT",
                      "REVENUE",
                      "SALES",
                      "TERMLIAB",
                      "PAYG"
                    ],
                    "description": "Account type."
                  },
                  "TaxType": {
                    "type": "string",
                    "nullable": true,
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Default tax code for the account. Open domain — org/region-specific, so deliberately NOT enumerated. Sample: NONE."
                  },
                  "Description": {
                    "type": "string",
                    "nullable": true,
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Description of the account."
                  },
                  "Class": {
                    "type": "string",
                    "nullable": true,
                    "native_type": "string:enum",
                    "arrow_type": "Utf8",
                    "enum": [
                      "ASSET",
                      "EQUITY",
                      "EXPENSE",
                      "LIABILITY",
                      "REVENUE"
                    ],
                    "description": "Accounting class of the account."
                  },
                  "SystemAccount": {
                    "type": "string",
                    "nullable": true,
                    "native_type": "string:enum",
                    "arrow_type": "Utf8",
                    "enum": [
                      "DEBTORS",
                      "CREDITORS",
                      "BANKCURRENCYGAIN",
                      "GST",
                      "GSTONIMPORTS",
                      "HISTORICAL",
                      "REALISEDCURRENCYGAIN",
                      "RETAINEDEARNINGS",
                      "ROUNDING",
                      "TRACKINGTRANSFERS",
                      "UNPAIDEXPCLM",
                      "UNREALISEDCURRENCYGAIN",
                      "WAGEPAYABLES",
                      "CISASSETS",
                      "CISASSET",
                      "CISLABOUR",
                      "CISLABOUREXPENSE",
                      "CISLABOURINCOME",
                      "CISLIABILITY",
                      "CISMATERIALS",
                      ""
                    ],
                    "description": "System-account identifier when Xero owns the account. The empty-string member is a real documented value."
                  },
                  "EnablePaymentsToAccount": {
                    "type": "boolean",
                    "nullable": true,
                    "native_type": "boolean",
                    "arrow_type": "Boolean",
                    "description": "Whether payments can be applied to this account."
                  },
                  "ShowInExpenseClaims": {
                    "type": "boolean",
                    "nullable": true,
                    "native_type": "boolean",
                    "arrow_type": "Boolean",
                    "description": "Whether the account is available on expense claims."
                  },
                  "BankAccountNumber": {
                    "type": "string",
                    "nullable": true,
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Bank account number, e.g. 0209087654321050. Populated for BANK accounts."
                  },
                  "BankAccountType": {
                    "type": "string",
                    "nullable": true,
                    "native_type": "string:enum",
                    "arrow_type": "Utf8",
                    "enum": [
                      "BANK",
                      "CREDITCARD",
                      "PAYPAL",
                      "NONE",
                      ""
                    ],
                    "description": "Bank account type. The empty-string member is a real documented value."
                  },
                  "CurrencyCode": {
                    "type": "string",
                    "nullable": true,
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "ISO-4217 currency code of the account, e.g. NZD."
                  },
                  "ReportingCode": {
                    "type": "string",
                    "nullable": true,
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Shown if set, e.g. EXP."
                  },
                  "ReportingCodeName": {
                    "type": "string",
                    "nullable": true,
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Shown if set, e.g. Expense."
                  },
                  "HasAttachments": {
                    "type": "boolean",
                    "nullable": true,
                    "native_type": "boolean",
                    "arrow_type": "Boolean",
                    "description": "Whether the account has attachments."
                  },
                  "UpdatedDateUTC": {
                    "type": "string",
                    "nullable": true,
                    "native_type": "msdate-time",
                    "arrow_type": "Timestamp(MILLISECOND, UTC)",
                    "description": "Last-modified timestamp in Xero MS-JSON form with an explicit offset, e.g. /Date(1550793549320+0000)/. Zone-aware per that sample. Replication cursor."
                  },
                  "AddToWatchlist": {
                    "type": "boolean",
                    "nullable": true,
                    "native_type": "boolean",
                    "arrow_type": "Boolean",
                    "description": "Whether the account is shown in the Xero dashboard watchlist."
                  }
                }
              }
            }
          }
        }
      }
    },
    "write": {
      "insert": {
        "request": {
          "method": "PUT",
          "path": "Accounts",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Xero Account (PUT Accounts request body)",
            "description": "One Account object. Xero's createAccount request body IS the Account schema itself — there is no array or envelope wrapper, so exactly one account is created per request. Requiredness is not declared: the researched facts ground the Account field set and its wire types, not the provider's per-field create requirements.",
            "type": "object",
            "properties": {
              "AccountID": {
                "type": "string",
                "format": "uuid",
                "native_type": "string:uuid",
                "arrow_type": "Utf8",
                "description": "Xero identifier for the account. Server-assigned on create; carried by the Account schema and returned in the write response."
              },
              "Code": {
                "type": "string",
                "native_type": "string",
                "arrow_type": "Utf8",
                "description": "Customer-defined account code, e.g. 091."
              },
              "Name": {
                "type": "string",
                "native_type": "string",
                "arrow_type": "Utf8",
                "description": "Name of the account."
              },
              "Status": {
                "type": "string",
                "native_type": "string:enum",
                "arrow_type": "Utf8",
                "enum": [
                  "ACTIVE",
                  "ARCHIVED",
                  "DELETED"
                ],
                "description": "Account status."
              },
              "Type": {
                "type": "string",
                "native_type": "string:enum",
                "arrow_type": "Utf8",
                "enum": [
                  "BANK",
                  "CURRENT",
                  "CURRLIAB",
                  "DEPRECIATN",
                  "DIRECTCOSTS",
                  "EQUITY",
                  "EXPENSE",
                  "FIXED",
                  "INVENTORY",
                  "LIABILITY",
                  "NONCURRENT",
                  "OTHERINCOME",
                  "OVERHEADS",
                  "PREPAYMENT",
                  "REVENUE",
                  "SALES",
                  "TERMLIAB",
                  "PAYG"
                ],
                "description": "Account type."
              },
              "TaxType": {
                "type": "string",
                "native_type": "string",
                "arrow_type": "Utf8",
                "description": "Default tax code. Open domain — org/region-specific, deliberately NOT enumerated."
              },
              "Description": {
                "type": "string",
                "native_type": "string",
                "arrow_type": "Utf8",
                "description": "Description of the account."
              },
              "Class": {
                "type": "string",
                "native_type": "string:enum",
                "arrow_type": "Utf8",
                "enum": [
                  "ASSET",
                  "EQUITY",
                  "EXPENSE",
                  "LIABILITY",
                  "REVENUE"
                ],
                "description": "Accounting class of the account."
              },
              "SystemAccount": {
                "type": "string",
                "native_type": "string:enum",
                "arrow_type": "Utf8",
                "enum": [
                  "DEBTORS",
                  "CREDITORS",
                  "BANKCURRENCYGAIN",
                  "GST",
                  "GSTONIMPORTS",
                  "HISTORICAL",
                  "REALISEDCURRENCYGAIN",
                  "RETAINEDEARNINGS",
                  "ROUNDING",
                  "TRACKINGTRANSFERS",
                  "UNPAIDEXPCLM",
                  "UNREALISEDCURRENCYGAIN",
                  "WAGEPAYABLES",
                  "CISASSETS",
                  "CISASSET",
                  "CISLABOUR",
                  "CISLABOUREXPENSE",
                  "CISLABOURINCOME",
                  "CISLIABILITY",
                  "CISMATERIALS",
                  ""
                ],
                "description": "System-account identifier; Xero-owned. The empty-string member is a real documented value."
              },
              "EnablePaymentsToAccount": {
                "type": "boolean",
                "native_type": "boolean",
                "arrow_type": "Boolean",
                "description": "Whether payments can be applied to this account."
              },
              "ShowInExpenseClaims": {
                "type": "boolean",
                "native_type": "boolean",
                "arrow_type": "Boolean",
                "description": "Whether the account is available on expense claims."
              },
              "BankAccountNumber": {
                "type": "string",
                "native_type": "string",
                "arrow_type": "Utf8",
                "description": "Bank account number; applies to BANK accounts."
              },
              "BankAccountType": {
                "type": "string",
                "native_type": "string:enum",
                "arrow_type": "Utf8",
                "enum": [
                  "BANK",
                  "CREDITCARD",
                  "PAYPAL",
                  "NONE",
                  ""
                ],
                "description": "Bank account type. The empty-string member is a real documented value."
              },
              "CurrencyCode": {
                "type": "string",
                "native_type": "string",
                "arrow_type": "Utf8",
                "description": "ISO-4217 currency code, e.g. NZD."
              },
              "ReportingCode": {
                "type": "string",
                "native_type": "string",
                "arrow_type": "Utf8",
                "description": "Reporting code, e.g. EXP."
              },
              "ReportingCodeName": {
                "type": "string",
                "native_type": "string",
                "arrow_type": "Utf8",
                "description": "Reporting code name, e.g. Expense."
              },
              "HasAttachments": {
                "type": "boolean",
                "native_type": "boolean",
                "arrow_type": "Boolean",
                "description": "Whether the account has attachments."
              },
              "UpdatedDateUTC": {
                "type": "string",
                "native_type": "msdate-time",
                "arrow_type": "Timestamp(MILLISECOND, UTC)",
                "description": "Last-modified timestamp, Xero MS-JSON with explicit offset. Maintained by Xero."
              },
              "AddToWatchlist": {
                "type": "boolean",
                "native_type": "boolean",
                "arrow_type": "Boolean",
                "description": "Whether the account is shown in the Xero dashboard watchlist."
              }
            }
          }
        },
        "idempotency": {
          "in": "header",
          "name": "Idempotency-Key"
        },
        "response": {
          "success_when": {
            "eq": [
              {
                "ref": "response.body.Status"
              },
              {
                "literal": "OK"
              }
            ]
          }
        }
      }
    }
  }
}
