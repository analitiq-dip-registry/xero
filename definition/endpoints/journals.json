{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "journals",
  "display_name": "Journals",
  "description": "Immutable accounting journals (the general ledger), one per posted transaction line set.",
  "tags": ["accounting", "journals"],
  "operations": {
    "read": {
      "request": {
        "method": "GET",
        "path": "Journals"
      },
      "params": {
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Return journals with JournalNumber greater than this value."
        },
        "If-Modified-Since": {
          "in": "header",
          "type": "string",
          "required": false,
          "controlled_by": "replication",
          "description": "RFC3339 timestamp; only journals created at or after are returned."
        }
      },
      "pagination": {
        "type": "keyset",
        "keyset": { "param": "offset", "order_by_field": "JournalNumber" },
        "stop_when": { "empty": { "ref": "response.body.Journals" } }
      },
      "replication": {
        "supported_methods": ["full_refresh", "incremental"],
        "cursor_mappings": [
          {
            "cursor_field": "CreatedDateUTC",
            "param": "If-Modified-Since",
            "operator": "gte",
            "format": "date-time"
          }
        ]
      },
      "response": {
        "records": { "ref": "response.body.Journals" },
        "schema": {
          "type": "object",
          "properties": {
            "Id":           { "type": "string", "native_type": "UUID",     "arrow_type": "Utf8" },
            "Status":       { "type": "string", "native_type": "String",   "arrow_type": "Utf8" },
            "ProviderName": { "type": "string", "native_type": "String",   "arrow_type": "Utf8" },
            "DateTimeUTC":  { "type": "string", "native_type": "DateTime", "arrow_type": "Utf8" },
            "Journals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "JournalID":      { "type": "string",  "native_type": "UUID",     "arrow_type": "Utf8" },
                  "JournalDate":    { "type": "string",  "native_type": "DateTime", "arrow_type": "Utf8" },
                  "JournalNumber":  { "type": "integer", "native_type": "Integer",  "arrow_type": "Int64" },
                  "CreatedDateUTC": { "type": "string",  "native_type": "DateTime", "arrow_type": "Utf8" },
                  "Reference":      { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "SourceID":       { "type": "string",  "native_type": "UUID",     "arrow_type": "Utf8" },
                  "SourceType":     { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "JournalLines":   { "type": "array",   "native_type": "Json",     "arrow_type": "Json" }
                }
              }
            }
          }
        }
      }
    }
  }
}
