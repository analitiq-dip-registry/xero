{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "items",
  "display_name": "Items",
  "description": "Inventory and non-inventory products/services (the items list).",
  "tags": ["accounting", "items", "settings"],
  "operations": {
    "read": {
      "request": {
        "method": "GET",
        "path": "Items",
        "headers": {
          "If-Modified-Since": { "from_param": "If-Modified-Since" }
        }
      },
      "params": {
        "If-Modified-Since": {
          "in": "header",
          "type": "string",
          "required": false,
          "controlled_by": "replication",
          "description": "RFC3339 timestamp; only records created/modified at or after are returned."
        }
      },
      "replication": {
        "supported_methods": ["full_refresh", "incremental"],
        "cursor_mappings": [
          {
            "cursor_field": "UpdatedDateUTC",
            "param": "If-Modified-Since",
            "operator": "gte",
            "format": "date-time"
          }
        ]
      },
      "response": {
        "records": { "ref": "response.body.Items" },
        "schema": {
          "type": "object",
          "properties": {
            "Id":           { "type": "string", "native_type": "UUID",     "arrow_type": "Utf8" },
            "Status":       { "type": "string", "native_type": "String",   "arrow_type": "Utf8" },
            "ProviderName": { "type": "string", "native_type": "String",   "arrow_type": "Utf8" },
            "DateTimeUTC":  { "type": "string", "native_type": "DateTime", "arrow_type": "Utf8" },
            "Items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "Code":                      { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "InventoryAssetAccountCode": { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "Name":                      { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "IsSold":                    { "type": "boolean", "native_type": "Boolean",  "arrow_type": "Boolean" },
                  "IsPurchased":               { "type": "boolean", "native_type": "Boolean",  "arrow_type": "Boolean" },
                  "Description":               { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "PurchaseDescription":       { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "PurchaseDetails":           { "type": "object",  "native_type": "Json",     "arrow_type": "Json" },
                  "SalesDetails":              { "type": "object",  "native_type": "Json",     "arrow_type": "Json" },
                  "IsTrackedAsInventory":      { "type": "boolean", "native_type": "Boolean",  "arrow_type": "Boolean" },
                  "TotalCostPool":             { "type": "number",  "native_type": "Decimal",  "arrow_type": "Float64" },
                  "QuantityOnHand":            { "type": "number",  "native_type": "Decimal",  "arrow_type": "Float64" },
                  "UpdatedDateUTC":            { "type": "string",  "native_type": "DateTime", "arrow_type": "Utf8" },
                  "ItemID":                    { "type": "string",  "native_type": "UUID",     "arrow_type": "Utf8" },
                  "StatusAttributeString":     { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "ValidationErrors":          { "type": "array",   "native_type": "Json",     "arrow_type": "Json" }
                }
              }
            }
          }
        }
      }
    }
  }
}
