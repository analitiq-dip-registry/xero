{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "invoices",
  "display_name": "Invoices",
  "description": "Sales (ACCREC) and purchase (ACCPAY) invoices.",
  "tags": ["accounting", "transactions"],
  "operations": {
    "read": {
      "request": {
        "method": "GET",
        "path": "Invoices"
      },
      "params": {
        "page": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "1-based page number."
        },
        "pageSize": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "default": 100,
          "maximum": 1000,
          "description": "Records per page (max 1000)."
        },
        "If-Modified-Since": {
          "in": "header",
          "type": "string",
          "required": false,
          "controlled_by": "replication",
          "description": "RFC3339 timestamp; only records created/modified at or after are returned."
        }
      },
      "pagination": {
        "type": "page",
        "page": { "param": "page", "initial": 1 },
        "limit": { "param": "pageSize", "default": 100, "max": 1000 },
        "stop_when": { "empty": { "ref": "response.body.Invoices" } }
      },
      "replication": {
        "supported_methods": ["full_refresh", "incremental"],
        "cursor_mappings": [
          {
            "cursor_field": "UpdatedDateUTC",
            "param": "If-Modified-Since",
            "operator": "gte",
            "format": "date-time"
          }
        ]
      },
      "response": {
        "records": { "ref": "response.body.Invoices" },
        "schema": {
          "type": "object",
          "properties": {
            "Id":           { "type": "string", "native_type": "UUID",     "arrow_type": "Utf8" },
            "Status":       { "type": "string", "native_type": "String",   "arrow_type": "Utf8" },
            "ProviderName": { "type": "string", "native_type": "String",   "arrow_type": "Utf8" },
            "DateTimeUTC":  { "type": "string", "native_type": "DateTime", "arrow_type": "Utf8" },
            "Invoices": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "Type":                { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "Contact":             { "type": "object",  "native_type": "Json",     "arrow_type": "Json" },
                  "LineItems":           { "type": "array",   "native_type": "Json",     "arrow_type": "Json" },
                  "Date":                { "type": "string",  "native_type": "DateTime", "arrow_type": "Utf8" },
                  "DueDate":             { "type": "string",  "native_type": "DateTime", "arrow_type": "Utf8" },
                  "LineAmountTypes":     { "type": "object",  "native_type": "Json",     "arrow_type": "Json" },
                  "InvoiceNumber":       { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "Reference":           { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "BrandingThemeID":     { "type": "string",  "native_type": "UUID",     "arrow_type": "Utf8" },
                  "Url":                 { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "CurrencyCode":        { "type": "object",  "native_type": "Json",     "arrow_type": "Json" },
                  "CurrencyRate":        { "type": "number",  "native_type": "Decimal",  "arrow_type": "Float64" },
                  "Status":              { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "SentToContact":       { "type": "boolean", "native_type": "Boolean",  "arrow_type": "Boolean" },
                  "ExpectedPaymentDate": { "type": "string",  "native_type": "DateTime", "arrow_type": "Utf8" },
                  "PlannedPaymentDate":  { "type": "string",  "native_type": "DateTime", "arrow_type": "Utf8" },
                  "CISDeduction":        { "type": "number",  "native_type": "Decimal",  "arrow_type": "Float64" },
                  "CISRate":             { "type": "number",  "native_type": "Decimal",  "arrow_type": "Float64" },
                  "SubTotal":            { "type": "number",  "native_type": "Decimal",  "arrow_type": "Float64" },
                  "TotalTax":            { "type": "number",  "native_type": "Decimal",  "arrow_type": "Float64" },
                  "Total":               { "type": "number",  "native_type": "Decimal",  "arrow_type": "Float64" },
                  "TotalDiscount":       { "type": "number",  "native_type": "Decimal",  "arrow_type": "Float64" },
                  "InvoiceID":           { "type": "string",  "native_type": "UUID",     "arrow_type": "Utf8" },
                  "RepeatingInvoiceID":  { "type": "string",  "native_type": "UUID",     "arrow_type": "Utf8" },
                  "HasAttachments":      { "type": "boolean", "native_type": "Boolean",  "arrow_type": "Boolean" },
                  "IsDiscounted":        { "type": "boolean", "native_type": "Boolean",  "arrow_type": "Boolean" },
                  "Payments":            { "type": "array",   "native_type": "Json",     "arrow_type": "Json" },
                  "Prepayments":         { "type": "array",   "native_type": "Json",     "arrow_type": "Json" },
                  "Overpayments":        { "type": "array",   "native_type": "Json",     "arrow_type": "Json" },
                  "AmountDue":           { "type": "number",  "native_type": "Decimal",  "arrow_type": "Float64" },
                  "AmountPaid":          { "type": "number",  "native_type": "Decimal",  "arrow_type": "Float64" },
                  "FullyPaidOnDate":     { "type": "string",  "native_type": "DateTime", "arrow_type": "Utf8" },
                  "AmountCredited":      { "type": "number",  "native_type": "Decimal",  "arrow_type": "Float64" },
                  "UpdatedDateUTC":      { "type": "string",  "native_type": "DateTime", "arrow_type": "Utf8" },
                  "CreditNotes":         { "type": "array",   "native_type": "Json",     "arrow_type": "Json" },
                  "Attachments":         { "type": "array",   "native_type": "Json",     "arrow_type": "Json" },
                  "HasErrors":           { "type": "boolean", "native_type": "Boolean",  "arrow_type": "Boolean" },
                  "StatusAttributeString": { "type": "string", "native_type": "String", "arrow_type": "Utf8" },
                  "ValidationErrors":    { "type": "array",   "native_type": "Json",     "arrow_type": "Json" },
                  "Warnings":            { "type": "array",   "native_type": "Json",     "arrow_type": "Json" },
                  "InvoiceAddresses":    { "type": "array",   "native_type": "Json",     "arrow_type": "Json" }
                }
              }
            }
          }
        }
      }
    }
  }
}
