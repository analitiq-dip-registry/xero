{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "contacts",
  "display_name": "Contacts",
  "description": "Xero contacts — customers, suppliers and other parties the connected organisation trades with. Reads are page-paginated and support incremental sync on UpdatedDateUTC via the If-Modified-Since request header. PUT creates a contact; POST creates-or-updates one matched on ContactID. Xero's includeArchived, summaryOnly, where, order, IDs and searchTerm query params are deliberately NOT declared: summaryOnly returns a reduced field set that would contradict this response schema, the free-form filter/sort/id params can never be populated (no default, no pagination/replication ownership, no meaningful stream operator set), and no reachable first-party source grounds a correct includeArchived default — so a plain read returns Xero's default non-archived set.",
  "tags": [
    "accounting",
    "contacts",
    "crm"
  ],
  "operations": {
    "read": {
      "request": {
        "method": "GET",
        "path": "Contacts",
        "headers": {
          "If-Modified-Since": {
            "from_param": "If-Modified-Since"
          }
        },
        "query": {
          "page": {
            "from_param": "page"
          },
          "pageSize": {
            "from_param": "pageSize"
          }
        }
      },
      "params": {
        "page": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "minimum": 1,
          "description": "1-based page number; owned by pagination."
        },
        "pageSize": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "minimum": 1,
          "description": "Records per page; owned by pagination. Xero documents a default of 100 and states no maximum, so no pagination `max` is declared."
        },
        "If-Modified-Since": {
          "in": "header",
          "type": "string",
          "required": false,
          "format": "date-time",
          "controlled_by": "replication",
          "description": "Xero returns only records created or modified at/after this timestamp. Wire format: 2020-02-06T12:17:43.202-08:00. Owned by replication (cursor UpdatedDateUTC)."
        }
      },
      "pagination": {
        "type": "page",
        "page": {
          "param": "page",
          "initial": 1,
          "increment_by": 1
        },
        "limit": {
          "param": "pageSize",
          "default": {
            "ref": "runtime.batch_size"
          }
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.Contacts"
          }
        }
      },
      "replication": {
        "supported_methods": [
          "full_refresh",
          "incremental"
        ],
        "cursor_mappings": [
          {
            "cursor_field": "UpdatedDateUTC",
            "param": "If-Modified-Since",
            "operator": "gte",
            "format": "date-time"
          }
        ]
      },
