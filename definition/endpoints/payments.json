{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "payments",
  "display_name": "Payments",
  "description": "Payments made against invoices, credit notes, prepayments and overpayments.",
  "tags": ["accounting", "transactions"],
  "operations": {
    "read": {
      "request": {
        "method": "GET",
        "path": "Payments",
        "query": {
          "page": { "from_param": "page" },
          "pageSize": { "from_param": "pageSize" }
        },
        "headers": {
          "If-Modified-Since": { "from_param": "If-Modified-Since" }
        }
      },
      "params": {
        "page": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "1-based page number."
        },
        "pageSize": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "default": 100,
          "maximum": 1000,
          "description": "Records per page (max 1000)."
        },
        "If-Modified-Since": {
          "in": "header",
          "type": "string",
          "required": false,
          "controlled_by": "replication",
          "description": "RFC3339 timestamp; only records created/modified at or after are returned."
        }
      },
      "pagination": {
        "type": "page",
        "page": { "param": "page", "initial": 1 },
        "limit": { "param": "pageSize", "default": 100, "max": 1000 },
        "stop_when": { "empty": { "ref": "response.body.Payments" } }
      },
      "replication": {
        "supported_methods": ["full_refresh", "incremental"],
        "cursor_mappings": [
          {
            "cursor_field": "UpdatedDateUTC",
            "param": "If-Modified-Since",
            "operator": "gte",
            "format": "date-time"
          }
        ]
      },
      "response": {
        "records": { "ref": "response.body.Payments" },
        "schema": {
          "type": "object",
          "properties": {
            "Id":           { "type": "string", "native_type": "UUID",     "arrow_type": "Utf8" },
            "Status":       { "type": "string", "native_type": "String",   "arrow_type": "Utf8" },
            "ProviderName": { "type": "string", "native_type": "String",   "arrow_type": "Utf8" },
            "DateTimeUTC":  { "type": "string", "native_type": "DateTime", "arrow_type": "Utf8" },
            "Payments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "Invoice":               { "type": "object",  "native_type": "Json",     "arrow_type": "Json" },
                  "CreditNote":            { "type": "object",  "native_type": "Json",     "arrow_type": "Json" },
                  "Prepayment":            { "type": "object",  "native_type": "Json",     "arrow_type": "Json" },
                  "Overpayment":           { "type": "object",  "native_type": "Json",     "arrow_type": "Json" },
                  "InvoiceNumber":         { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "CreditNoteNumber":      { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "BatchPayment":          { "type": "object",  "native_type": "Json",     "arrow_type": "Json" },
                  "Account":               { "type": "object",  "native_type": "Json",     "arrow_type": "Json" },
                  "Code":                  { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "Date":                  { "type": "string",  "native_type": "DateTime", "arrow_type": "Utf8" },
                  "CurrencyRate":          { "type": "number",  "native_type": "Decimal",  "arrow_type": "Float64" },
                  "Amount":                { "type": "number",  "native_type": "Decimal",  "arrow_type": "Float64" },
                  "BankAmount":            { "type": "number",  "native_type": "Decimal",  "arrow_type": "Float64" },
                  "Reference":             { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "IsReconciled":          { "type": "boolean", "native_type": "Boolean",  "arrow_type": "Boolean" },
                  "Status":                { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "PaymentType":           { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "UpdatedDateUTC":        { "type": "string",  "native_type": "DateTime", "arrow_type": "Utf8" },
                  "PaymentID":             { "type": "string",  "native_type": "UUID",     "arrow_type": "Utf8" },
                  "BatchPaymentID":        { "type": "string",  "native_type": "UUID",     "arrow_type": "Utf8" },
                  "BankAccountNumber":     { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "Particulars":           { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "Details":               { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "HasAccount":            { "type": "boolean", "native_type": "Boolean",  "arrow_type": "Boolean" },
                  "HasValidationErrors":   { "type": "boolean", "native_type": "Boolean",  "arrow_type": "Boolean" },
                  "StatusAttributeString": { "type": "string",  "native_type": "String",   "arrow_type": "Utf8" },
                  "ValidationErrors":      { "type": "array",   "native_type": "Json",     "arrow_type": "Json" },
                  "Warnings":              { "type": "array",   "native_type": "Json",     "arrow_type": "Json" }
                }
              }
            }
          }
        }
      }
    }
  }
}
